# Skin Cancer Detection System - Docker Environment Configuration

# Flask settings
FLASK_ENV=production
FLASK_APP=deploy_api.py
FLASK_DEBUG=0

# API Settings
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
API_TIMEOUT=30

# Model settings
MODEL_PATH=./checkpoints/best_model.pt
MODEL_NAME=resnet50
DEVICE=cpu
# Set to 'cuda' if GPU is available: DEVICE=cuda

# Inference settings
BATCH_SIZE=32
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/api.log

# Security
CORS_ENABLED=true
CORS_ORIGINS=*
# For production, restrict to specific domains
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Database/Monitoring (if needed)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT=30
